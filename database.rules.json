{
  "rules": {
    "roomIndex": {
      ".indexOn": ".value",
      ".read": "auth != null && query.orderByValue == true && query.endAt != null && query.endAt <= now - 7200000",
      "$code": {
        ".write": "auth != null && ((newData.exists() && newData.parent().parent().child('rooms/' + $code + '/meta/owner').val() === auth.uid) || (!newData.exists() && (data.val() < now - 7200000 || root.child('rooms/' + $code + '/meta/owner').val() === auth.uid)))",
        ".validate": "newData.isNumber() && newData.val() <= now"
      }
    },
    "rooms": {
      "$code": {
        ".validate": "$code.matches(/^[0-9]{6}$/)",
        ".read": "auth != null && (data.child('meta/owner').val() === auth.uid || data.child('meta/remote').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('meta/owner').val() === auth.uid) || data.child('meta/owner').val() === auth.uid || (!newData.exists() && root.child('roomIndex/' + $code).val() < now - 7200000))",
        "meta": {
          ".read": "auth != null",
          "owner": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "pageCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000" },
          "remote": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
            ".validate": "newData.isString() && newData.parent().child('owner').exists()"
          },
          "remoteName": {
            ".write": "auth != null && ((newData.exists() && newData.parent().child('remote').val() === auth.uid) || (!newData.exists() && data.parent().child('remote').val() === auth.uid))",
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": { ".validate": false }
        },
        "hb": {
          "laptop": { ".validate": "newData.isNumber()" },
          "remote": {
            ".write": "auth != null && root.child('rooms/' + $code + '/meta/remote').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "$other": { ".validate": false }
        },
        "state": {
          "page": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000" },
          "black": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },
        "cmds": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('rooms/' + $code + '/meta/remote').val() === auth.uid",
            ".validate": "newData.hasChildren(['type', 'at'])",
            "type": { ".validate": "newData.val() === 'next' || newData.val() === 'prev' || newData.val() === 'goto' || newData.val() === 'black'" },
            "page": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "thumbs": {
          "$n": {
            ".validate": "$n.matches(/^[0-9]{1,4}$/) && newData.isString() && newData.val().length <= 40000 && newData.val().beginsWith('data:image/jpeg;base64,')"
          }
        },
        "timer": {
          "startAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "laser": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/remote').val() === auth.uid",
          ".validate": "newData.hasChildren(['x', 'y'])",
          "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
